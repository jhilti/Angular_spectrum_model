{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ASM: Standardfall",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/custom_case.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "ASM: DMSO 70–100 %",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/dmso_concentration_sweep.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "ASM: Pulse-Echo 80 % DMSO",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/pulse_echo_80pct_dmso.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "ASM: Survey-JSON-Vergleich",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/survey_json_comparison.py",
            "args": [
                "${input:surveyJson}",
                "--dmso-percent",
                "73",
                "--temperature-c",
                "22",
                "--known-water-path-mm",
                "25.3"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "ASM: Meniskus-Intensität 2–3 mm",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/meniscus_intensity_sweep.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "surveyJson",
            "type": "promptString",
            "description": "Absoluter Pfad zur Survey-JSON-Datei"
        }
    ]
}
